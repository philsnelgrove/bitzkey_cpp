// The app's icon and version details, shown by Explorer, the taskbar and the installer.
1 ICON "bitzkey.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Bitzkey"
            VALUE "FileVersion", "1.0.0"
            VALUE "ProductName", "Bitzkey"
            VALUE "ProductVersion", "1.0.0"
            VALUE "OriginalFilename", "bitzkey.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
