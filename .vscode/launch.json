{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Bitzkey (windowed)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/bitzkey.exe",
      "args": ["--windowed"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Run bitzkey_cli (seed 1, 400 turns)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/bitzkey_cli.exe",
      "args": ["--seed", "1", "--turns", "400"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/bitzkey_tests.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
